generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  refreshTokens RefreshToken[]
  addresses     Address[]
  orders        Order[]
  payments      Payment[]
  subscriptions Subscription[]
  loans         Loan[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  rotatedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum CopyStatus {
  AVAILABLE
  RESERVED
  ON_LOAN
  LOST
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  books Book[]
}

model Book {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  author      String
  isbn        String     @unique
  description String
  coverUrl    String?
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  salePrice   Int?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  saleStock   SaleStock?
  copies      BookCopy[]
  orderItems  OrderItem[]

  @@index([categoryId])
}

model SaleStock {
  bookId   String @id
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity Int    @default(0)
}

model BookCopy {
  id        String     @id @default(cuid())
  bookId    String
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  barcode   String     @unique
  status    CopyStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  loans     Loan[]

  @@index([bookId, status])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LoanStatus {
  REQUESTED
  ACTIVE
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

enum ShipmentType {
  ORDER_DELIVERY
  LOAN_DELIVERY
  LOAN_PICKUP
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

// One default per user: partial unique index address_one_default_per_user (hand-written SQL, orders migration).
// No zone column: zoneOf(city) derives it (spec §3.1).
model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  line          String
  ward          String
  city          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Int
  shippingFee     Int
  total           Int
  addressSnapshot Json
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]

  @@index([userId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int

  @@index([orderId])
  @@index([bookId])
}

// Exactly one of orderId / subscriptionId: CHECK payment_exactly_one_target (hand-written SQL).
model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Int
  status         PaymentStatus @default(PENDING)
  providerRef    String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([subscriptionId])
  @@index([status, createdAt])
}

model Plan {
  id                String         @id @default(cuid())
  code              String         @unique
  name              String
  maxBooks          Int
  monthlyPrice      Int
  active            Boolean        @default(true)
  subscriptions     Subscription[] @relation("SubscriptionPlan")
  nextSubscriptions Subscription[] @relation("SubscriptionNextPlan")
}

// At most one open (PENDING_PAYMENT | ACTIVE) subscription per user: partial unique index
// subscription_one_open_per_user (hand-written SQL, subscriptions migration). spec §3.3, §4.2.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  planId             String
  plan               Plan               @relation("SubscriptionPlan", fields: [planId], references: [id])
  nextPlanId         String?
  nextPlan           Plan?              @relation("SubscriptionNextPlan", fields: [nextPlanId], references: [id])
  status             SubscriptionStatus @default(PENDING_PAYMENT)
  currentPeriodStart DateTime?          @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  payments           Payment[]
  loans              Loan[]

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

// ORDER_DELIVERY must have an orderId: CHECK shipment_order_delivery_has_order (hand-written SQL, shipments
// migration). retryOfId is unique so a FAILED shipment can be retried only once (spec §3.6, §4.6).
model Shipment {
  id              String          @id @default(cuid())
  type            ShipmentType
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status          ShipmentStatus  @default(PENDING)
  fee             Int
  addressSnapshot Json
  retryOfId       String?         @unique
  retryOf         Shipment?       @relation("ShipmentRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retriedBy       Shipment?       @relation("ShipmentRetry")
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  events          ShipmentEvent[]
  deliveryLoans   Loan[]          @relation("LoanDelivery")
  returnLoans     Loan[]          @relation("LoanReturn")

  @@index([orderId])
  @@index([status, createdAt])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([shipmentId])
}

// Delivery progress lives on Shipment; after a retry the shipment ids point at the new shipment (spec §3.3, §4.6).
// Every multi-row write locks rows in id order first (lockLoans). bookCopyId Restrict: deleting a book whose
// copy was ever lent fails with P2003 → 409 IN_USE.
model Loan {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  bookCopyId         String
  bookCopy           BookCopy     @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  status             LoanStatus   @default(REQUESTED)
  deliveryShipmentId String
  deliveryShipment   Shipment     @relation("LoanDelivery", fields: [deliveryShipmentId], references: [id], onDelete: Restrict)
  returnShipmentId   String?
  returnShipment     Shipment?    @relation("LoanReturn", fields: [returnShipmentId], references: [id], onDelete: Restrict)
  requestedAt        DateTime     @default(now()) @db.Timestamptz(3)
  deliveredAt        DateTime?    @db.Timestamptz(3)
  returnedAt         DateTime?    @db.Timestamptz(3)

  @@index([userId, status])
  @@index([deliveryShipmentId])
  @@index([returnShipmentId])
}

